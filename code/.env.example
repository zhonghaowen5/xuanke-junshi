# 复制本文件为 .env，填入自己的 Key
# 阿里云百炼控制台 → API-KEY 管理 → 创建新的 API-KEY
DASHSCOPE_API_KEY=sk-替换成你自己的Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 大模型：qwen-plus 性价比最高，开发/评测足够用
# 如需要更强的效果，决赛前可换成 qwen3.8-max（注意：费用更高、响应更慢）
LLM_MODEL=qwen-plus

# 向量模型：text-embedding-v3 稳定且便宜，不建议换
EMBED_MODEL=text-embedding-v3
